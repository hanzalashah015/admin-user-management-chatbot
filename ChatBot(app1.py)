def init_db():
    conn = get_connection()
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            email TEXT UNIQUE NOT NULL,
            phone TEXT,
            city TEXT
        )
    """)

    # Default admin
    cursor.execute("""
        INSERT OR IGNORE INTO users
        (name, email, phone, city)
        VALUES (?, ?, ?, ?)
    """, (
